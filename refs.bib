@article{10.1145/3771098,
author = {Ferreira-Lopes, Patricia and Gonz\'{a}lez-Gracia, Elena},
title = {Performing a Systematic Literature Review on the Implementation of the CIDOC CRM in Cultural Heritage},
year = {2025},
issue_date = {December 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {18},
number = {4},
issn = {1556-4673},
url = {https://doi.org/10.1145/3771098},
doi = {10.1145/3771098},
abstract = {This article examines the implementation of the Conceptual Reference Model of the International Committee for Documentation (CIDOC CRM) in cultural heritage by performing a systematic review of the literature. We have analysed publications that describe one or more case studies, collections, archives and so on concerning the implementation of the CIDOC CRM. Among other aims, the review sought to identify the heritage categories in which the CIDOC CRM is usually implemented; the degree to which the studies are accessible to humanist readers; whether extensions or new ontologies models have been proposed; whether new tools have had to be created for the implementation; and whether the published studies have included a quantitative or qualitative analysis of the implementation. The results suggest a much greater degree of implementation in movable heritage and low application in intangible heritage. They also suggest that most of the published studies demand an advanced level of computer literacy from readers, which somewhat hinders access by humanist professionals and researchers, thus deterring their collaboration and/or interest. Furthermore, the results indicate that one-third of the studies developed a full or complete extension to the CIDOC CRM and that in approximately half of the studies a new tool was developed and created for the purpose pursued in a specific project or by a specific institution. Following a review of the literature, the article presents a series of considerations and recommendations for future lines of work with a view to extending the implementation of the CIDOC CRM in the cultural heritage sector and contributing to the construction of a more integrated information infrastructure ecosystem.},
journal = {J. Comput. Cult. Herit.},
month = dec,
articleno = {68},
numpages = {16},
keywords = {CIDOC CRM, cultural heritage, ontology, knowledge graph, data integration, semantic model}
}

